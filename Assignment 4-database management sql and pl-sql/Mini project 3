5.Create a stored procedure named GetMonthlyPlaylistCount that takes a user_id and a month (as an integer) as input, and returns the total number of playlists 
the user created in that month.<br><br><em><strong>Hint:</strong> Use the MONTH() function in your WHERE clause.</em>
Ans.
delimiter $$
create procedure GetMonthlyPlaylistCount(
    in p_user_id int,
    in p_month int
)
begin
    select count(*) as total_playlists
    from playlists
    where user_id=p_user_id 
      and month(created_at)=p_month;
end $$
delimiter ;
