Build a two-table schema for restaurants and menu items, write JOIN queries to combine data, and create a summary VIEW.

1.Create two tables: restaurants (restaurant_id, name, city) and menu_items (item_id,
restaurant_id, item_name, price, category). Link them with a FOREIGN KEY on restaurant_id.

create table restaurants (
    restaurant_id int auto_increment primary key,
    name varchar(50),
    city varchar(30)
);

create table menu_items (
    item_id int auto_increment primary key,
    restaurant_id int,
    item_name varchar(50),
    price decimal(10,2),
    category varchar30),
    foreign key (restaurant_id) references restaurants(restaurant_id)
);

