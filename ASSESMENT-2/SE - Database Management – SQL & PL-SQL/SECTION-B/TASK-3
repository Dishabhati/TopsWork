3.Write an INNER JOIN query listing restaurant name, item name, and price for all available items.

select restaurants.name, menu_items.item_name, menu_items.price 
from restaurants, menu_items 
where restaurants.restaurant_id = menu_items.restaurant_id;

4.Write a LEFT JOIN query so that restaurants with no items also appear in results, with NULL values in item columns.

select restaurants.name, menu_items.item_name, menu_items.price 
from restaurants 
left join menu_items ON restaurants.restaurant_id = menu_items.restaurant_id;

5.Create a VIEW named restaurant_menu_summary showing restaurant name, total number of menu items, and average item price grouped by restaurant

create view restaurant_menu_summary as
select restaurants.name, count(menu_items.item_id) as total_items, avg(menu_items.price) as avg_item_price 
from restaurants 
left join menu_items on restaurants.restaurant_id = menu_items.restaurant_id 
group by restaurants.name;
