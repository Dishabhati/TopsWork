5.Write a TRIGGER named after_order_insert that logs a record into an order_audit table
(order_id, restaurant_id, action='INSERT', log_time=NOW()) immediately after every new order
is created

delimiter $$

create trigger after_order_insert
after insert on orders
for each row
begin
    -- logs the new order action after insert
    insert into order_audit (order_id, restaurant_id, action, log_date)
    values (new.order_id, new.restaurant_id, 'insert', curdate());
end $$

delimiter ;
