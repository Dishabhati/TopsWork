3.Create a VIEW named restaurant_sales_summary showing restaurant name, total number of
orders, and total revenue grouped by restaurant.

create view restaurant_sales_summary as
select 
    restaurants.name as restaurant_name,
    count(orders.order_id) as total_orders,
    sum(orders.total_amount) as total_revenue
from 
    restaurants
left join 
    orders on restaurants.restaurant_id = orders.restaurant_id
group by 
    restaurants.name;


