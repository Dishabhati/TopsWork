Ans-
delimiter $$

create procedure get_monthly_restaurant_summary(in p_restaurant_id int, in p_month int)
begin
    declare v_order_count int;
    
    -- check how many orders exist for that restaurant and month
    select count(*) into v_order_count 
    from orders 
    where restaurant_id = p_restaurant_id and month(order_date) = p_month;
    
    -- handle zero orders with a meaningful message
    if v_order_count = 0 then
        select 'no orders found for this restaurant in the specified month.' as message;
    else
        select count(order_id) as total_orders, 
               sum(total_amount) as total_revenue, 
               avg(total_amount) as avg_order_value
        from orders
        where restaurant_id = p_restaurant_id and month(order_date) = p_month;
    end if;
end $$

delimiter ;

