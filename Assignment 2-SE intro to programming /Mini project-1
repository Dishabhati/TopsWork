#include <stdio.h>
int main()
{
    int minutes[7]={0};
    int choice,i;
    int total,highest;
    float average;
    char confirm;

    while(1)
    {
        printf("\n===== MUSIC LISTENING LOGGER =====\n");
        printf("1. Log listening minutes\n");
        printf("2. View weekly summary\n");
        printf("3. Reset weekly data\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        if(choice == 1)
        {
            printf("\nEnter listening minutes for 7 days:\n");

            for(i = 0; i < 7; i++)
            {
                printf("Day %d: ", i + 1);
                scanf("%d", &minutes[i]);
            }

            /* Save data to file */
            FILE *fp;
            fp = fopen("music_log.txt", "w");

            if(fp == NULL)
            {
                printf("File could not be opened.\n");
            }
            else
            {
                for(i = 0; i < 7; i++)
                {
                    fprintf(fp, "%d\n", minutes[i]);
                }

                fclose(fp);
                printf("Music listening data saved successfully.\n");
            }
        }

        else if(choice == 2)
        {
            FILE *fp;
            fp = fopen("music_log.txt", "r");

            if(fp == NULL)
            {
                printf("\nNo music data found.\n");
            }
            else
            {
                total = 0;
                highest = 0;

                /* Read data from file */
                for(i = 0; i < 7; i++)
                {
                    fscanf(fp, "%d", &minutes[i]);

                    total = total + minutes[i];

                    if(minutes[i] > highest)
                    {
                        highest = minutes[i];
                    }
                }

                fclose(fp);

                average = total / 7.0;

                printf("\n===== WEEKLY REPORT =====\n");

                for(i = 0; i < 7; i++)
                {
                    printf("Day %d: %d minutes\n", i + 1, minutes[i]);
                }

                printf("\nTotal listening minutes: %d\n", total);
                printf("Average listening minutes: %.2f\n", average);
                printf("Highest listening minutes: %d\n", highest);
            }
        }

        else if(choice == 3)
        {
            printf("\nAre you sure you want to reset all data? (y/n): ");
            scanf(" %c", &confirm);

            if(confirm == 'y' || confirm == 'Y')
            {
                /* Clear array */
                for(i = 0; i < 7; i++)
                {
                    minutes[i] = 0;
                }

                /* Clear file contents */
                FILE *fp;
                fp = fopen("music_log.txt", "w");

                if(fp)
                {
                    fclose(fp);
                }

                printf("Weekly data has been reset.\n");
            }
            else
            {
                printf("Reset cancelled.\n");
            }
        }

        else if(choice == 4)
        {
            printf("Thank you for using Music Listening Logger!\n");
            break;
        }

        else
        {
            printf("Invalid choice. Please try again.\n");
        }
    }
}
