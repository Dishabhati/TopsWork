#include <stdio.h>
int main()
{
    int a[7]={0};
    int i,choice,total,highest;
    float average;
    char ch;
    FILE*fp;

    while(1)
    {
        printf("\n1. Log Minutes");
        printf("\n2. Weekly Report");
        printf("\n3. Reset Data");
        printf("\n4. Exit");
        printf("\nEnter choice: ");
        scanf("%d",&choice);

        if(choice==1)
        {
            fp=fopen("music_log.txt","w");

            printf("\nEnter minutes for 7 days:\n");

            for(i=0;i<7;i++)
            {
                printf("Day %d: ",i+1);
                scanf("%d",&a[i]);
                fprintf(fp, "%d\n",a[i]);
            }

            fclose(fp);
            printf("Data saved.\n");
        }

        else if(choice==2)
        {
            fp=fopen("music_log.txt","r");

            total=0;
            highest=0;

            for(i=0;i<7;i++)
            {
                fscanf(fp,"%d",&a[i]);

                total=total+a[i];

                if(a[i]>highest)
                    highest=a[i];
            }

            fclose(fp);

            average=total/7.0;

            printf("\nTotal=%d",total);
            printf("\nAverage=%.2f",average);
            printf("\nHighest=%d\n",highest);
        }

        else if(choice==3)
        {
            printf("Reset data? (y/n): ");
            scanf("%c",&ch);

            if(ch=='y' || ch=='Y')
            {
                for(i=0;i<7;i++)
                    a[i]=0;

                fp=fopen("music_log.txt","w");
                fclose(fp);

                printf("Data reset.\n");
            }
        }

        else if(choice==4)
        {
            printf("Thank you!\n");
            break;
        }

        else
        {
            printf("Invalid choice.\n");
        }
    }
}
