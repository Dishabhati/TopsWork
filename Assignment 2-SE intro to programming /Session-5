2.Build a Zomato-style food suggestion tool: take the user's preferred meal time ('breakfast', 'lunch', 'dinner', or 'snack') and use a switch-case statement to suggest a popular dish for that time. If the input doesn't match any meal, suggest 'Try some fruits!'.
Ans.
#include<stdio.h>
int main()
{
	int meal;
	
	printf("1: breakfast\n");
	printf("2: lunch\n");
	printf("3: dinner\n");
	printf("4: snacks\n");
	
	printf("Enter your meal");
	scanf("%d",&meal);
	switch (meal) {
		case 1: 
		   printf("Try dosa");
		   break;
		case 2:
		   printf("Try palak panner and roti");
		   break;
		case 3:
		   printf("Try punjabi thali");
		   break;
		case 4:
		   printf("Try sandwich");
		   break;
		default:
		   printf("Try some fruits"); 
		   break;           
	}
}

