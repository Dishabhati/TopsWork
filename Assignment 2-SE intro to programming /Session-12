1.Declare a structure named Playlist to store details of a song: title (string), artist (string), and duration in seconds (integer). Initialize one Playlist variable with your favorite song's details and print each field.
Ans.
#include <iostream>
using namespace std;
struct Playlist
{
    string title;
    string artist;
    int duration;
};

int main()
{
    Playlist song={"Vaste","dhvani bhanushali",262};

    cout<<"Title:"<<song.title<<endl;
    cout<<"Artist:"<<song.artist<<endl;
    cout<<"Duration:"<<song.duration<<" seconds";
}


2.Create a structure called FoodItem to store Zomato-style menu data: itemName (string), price (float), and rating (float). Initialize an array of 3 FoodItem variables with real menu items and display their details using a loop.
Ans.
#include <iostream>
using namespace std;
struct FoodItem
{
    string itemName;
    float price;
    float rating;
};

int main()
{
    FoodItem food[3]=
    {
        {"Pizza",250,4.5},
        {"Burger",150,4.2},
        {"Momos",100,4.7}
    };

    for(int i=0;i<3;i++)
    {
        cout<<"Item:"<<food[i].itemName<<endl;
        cout<<"Price:"<<food[i].price<<endl;
        cout<<"Rating:"<<food[i].rating<<endl;
        cout<<endl;
    }
}


