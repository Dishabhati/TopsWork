1.Write a simple C program tasklist_c.c that allows you to add up to 5 tasks (as strings) to a global array and print all tasks using a for loop.
Ans.
#include <stdio.h>
char tasks[5][50];
int main()
{
    int i;
    for(i=0;i<5;i++)
    {
        printf("Enter task:");
        scanf(" %[^\n]",tasks[i]);
    }
    printf("\nTask List:\n");
    for(i=0;i<5;i++)
    {
        printf("%d. %s\n",i+1,tasks[i]);
    }
}


2.Modify your tasklist_c.c to add a function markTaskDone(int index) that sets the selected task to 'DONE' in the array, then print the updated list.<br><br><em><strong>Hint:</strong> Use a separate status array or append ' - DONE' to the task string.</em>
Ans.
#include <stdio.h>
char tasks[5][50];
int count=0;
void markTaskDone(int index)
{
    printf("%s - DONE\n",tasks[index]);
}
int main()
{
    int i;
    for(i=0;i<3;i++)
    {
        printf("Enter task: ");
        scanf(" %[^\n]",tasks[i]);
        count++;
    }
    printf("\nTasks:\n");
    for(i=0;i<count;i++)
    {
        if(i==1)
            markTaskDone(i);
        else
            printf("%s - Pending\n",tasks[i]);
    }
}


3.Create a Task class in your favorite OOP language (Java, Python, or C++) with properties: title and isDone. Add a method markDone() that sets isDone to true, and a method display() that prints the task with its status.
Ans-
#include <iostream>
using namespace std;
class Task
{
public:
    string title;
    string status="Pending";

    void markDone()
    {
        status="DONE";
    }
    void display()
    {
        cout<<title<<"-"<<status<<endl;
    }
};

int main()
{
    Task t;
    t.title="Study";
    t.display();
    t.markDone();
    t.display();
}


4.Build a simple TaskList class/object that stores multiple Task objects and provides addTask(title), markTaskDone(index), and showTasks() methods. Demonstrate adding 3 tasks, marking one as done, and displaying all tasks with their statuses.
Ans-
#include <iostream>
using namespace std;
class Task
{
public:
    string title;
    string status="Pending";
};
class TaskList
{
public:
    Task tasks[5];
    int count=0;

    void addTask(string name)
    {
        tasks[count].title=name;
        count++;
    }
    void markTaskDone(int index)
    {
        tasks[index].status="DONE";
    }
    void showTasks()
    {
        for(int i=0;i<count;i++)
        {
            cout<<tasks[i].title<<"-"<< tasks[i].status<<endl;
        }
    }
};
int main()
{
    TaskList list;

    list.addTask("Shopping");
    list.addTask("Study");
    list.addTask("Assignment");
    list.markTaskDone(1);
    list.showTasks();
}


