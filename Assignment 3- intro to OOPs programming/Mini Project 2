1.Create a Content class with properties: title, platform, views, and status. Write a method to display all details of a Content object.
Ans.
#include <iostream>
using namespace std;
class Content
{
public:
    string title,platform,status;
    int views;

    void display()
    {
        cout<<title<<endl;
        cout<<platform<<endl;
        cout<<views<<endl;
        cout<<status<<endl;
    }
};
int main()
{
    Content c;

    c.title="Dance";
    c.platform="Instagram";
    c.views=500;
    c.status="Pending";

    c.display();
}


