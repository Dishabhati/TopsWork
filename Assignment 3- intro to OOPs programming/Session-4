1.Create a base class called SocialMediaUser with properties username and followers, and a method displayProfile() that prints the username and follower count.
Ans.
#include <iostream>
using namespace std;
class SocialMediaUser
{
public:
    string username;
    int followers;

    void displayProfile()
    {
        cout<<"Username:"<<username<<endl;
        cout<<"Followers:"<<followers<<endl;
    }
};
int main()
{
    SocialMediaUser user;

    user.username="Disha";
    user.followers=1000;
    user.displayProfile();
}


2.Build a YouTuber class that inherits from SocialMediaUser and adds a property channelName and a method uploadVideo(title) that prints 'Video [title] uploaded to [channelName]'.
Ans.
#include <iostream>
using namespace std;
class SocialMediaUser
{
public:
    string username;
    int followers;

    void displayProfile()
    {
        cout<<username<<endl;
        cout<<followers<<endl;
    }
};
class YouTuber : public SocialMediaUser
{
public:
    string channelName;
    void uploadVideo(string title)
    {
        cout<<"Video: "<<title<<" uploaded to "<<channelName<<endl;
    }
};
int main()
{
    YouTuber y;

    y.username="Disha";
    y.followers=1000;
    y.channelName="Disha Vlogs";

    y.displayProfile();
    y.uploadVideo("My First Video");
}


