    }
};
int main()
{
    Playlist p;
    cout<<"Playlist: "<<p.name;
}

2.Build a class Product for a Flipkart-style app with a parameterized constructor that takes productName, price, and rating as arguments and displays all details using a displayInfo() method.
Ans.
#include <iostream>
using namespace std;
class Product
{
public:
    string productName;
    int price;
    float rating;
    Product(string n,int p,float r)
    {
        productName=n;
        price=p;
        rating=r;
    }
    void displayInfo()
    {
        cout<<productName<<endl;
        cout<<price<<endl;
        cout<<rating<<endl;
    }
};
int main()
{
    Product p("Shoes",1500,4.5);
    p.displayInfo();
}


3.Create a class Movie with a parameterized constructor and then use a copy constructor to duplicate a Movie object. Print both the original and copied movie details to show they are identical.
Ans.
#include <iostream>
using namespace std;
class Movie
{
public:
    string name;
    int year;

    Movie(string n,int y)
    {
        name=n;
        year=y;
    }

    Movie(Movie &m)
    {
        name=m.name;
        year=m.year;
    }

    void display()
    {
        cout<<name<<" "<<year<<endl;
    }
};
int main()
{
    Movie m1("Avatar",2009);
    Movie m2(m1);

    m1.display();
    m2.display();
}


